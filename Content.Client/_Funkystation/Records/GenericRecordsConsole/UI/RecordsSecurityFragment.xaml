<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._CD.Records.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Orientation="Vertical">
    <BoxContainer Margin="5" Orientation="Horizontal">
        <Label
            Name="FingerprintsTitle"
            StyleClasses="LabelSecondaryColor"
            Text="{Loc 'funky-records-fingerprints-title'}" />
        <Label Margin="5,0" Name="RecordContainerFingerprints" />
    </BoxContainer>
    <BoxContainer Margin="5" Orientation="Horizontal">
        <Label
            Name="DNATitle"
            StyleClasses="LabelSecondaryColor"
            Text="{Loc 'funky-records-dna-title'}" />
        <Label Margin="5,0" Name="RecordContainerDNA" />
    </BoxContainer>

    <BoxContainer Orientation="Horizontal" Margin="5 5 5 5">
        <Label Text="{Loc 'funky-records-console-status'}" FontColorOverride="DarkGray" />
        <OptionButton Name="StatusOptionButton" Margin="5,0"/>
    </BoxContainer>

    <ui:RecordLongItemDisplay Margin="5" Name="WantedReason" Visible="False" />
</BoxContainer>
