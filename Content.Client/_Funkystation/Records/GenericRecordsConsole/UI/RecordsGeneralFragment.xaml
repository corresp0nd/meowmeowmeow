<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._CD.Records.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Orientation="Vertical">
    <BoxContainer Margin="5" Orientation="Horizontal">
        <Label
            Name="JobTitle"
            StyleClasses="LabelSecondaryColor"
            Text="{Loc 'funky-records-job-title'}" />
        <Label Margin="5,0" Name="RecordContainerJob" />
    </BoxContainer>
    <BoxContainer Margin="5" Orientation="Horizontal">
        <Label
            Name="GenderTitle"
            StyleClasses="LabelSecondaryColor"
            Text="{Loc 'funky-records-gender-title'}" />
        <Label Margin="5,0" Name="RecordContainerGender" />
    </BoxContainer>
    <BoxContainer Margin="5" Orientation="Horizontal">
        <Label
            Name="SpeciesTitle"
            StyleClasses="LabelSecondaryColor"
            Text="{Loc 'funky-records-species-title'}" />
        <Label Margin="5,0" Name="RecordContainerSpecies" />
    </BoxContainer>
    <BoxContainer Margin="5" Orientation="Horizontal">
        <Label
            Name="AgeTitle"
            StyleClasses="LabelSecondaryColor"
            Text="{Loc 'funky-records-age-title'}" />
        <Label Margin="5,0" Name="RecordContainerAge" />
    </BoxContainer>
    <BoxContainer Margin="5" Orientation="Horizontal">
        <Label
            Name="HeightTitle"
            StyleClasses="LabelSecondaryColor"
            Text="{Loc 'funky-records-height-title'}" />
        <Label Margin="5,0" Name="RecordContainerHeight" />
    </BoxContainer>
    <BoxContainer Margin="5" Orientation="Horizontal">
        <Label
            Name="WeightTitle"
            StyleClasses="LabelSecondaryColor"
            Text="{Loc 'funky-records-weight-title'}" />
        <Label Margin="5,0" Name="RecordContainerWeight" />
    </BoxContainer>
</BoxContainer>
